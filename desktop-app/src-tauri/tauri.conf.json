{
  "productName": "Yousoro Workspace",
  "version": "0.1.2",
  "identifier": "ru.yousoro.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yousoro Workspace",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "externalBin": [
      "binaries/xray"
    ],
    "resources": [
      "resources/"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "windows-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3Nzk1NkUyOTgxRUIyQjMKUldTenNoNlk0bFo1aDZLMVpESE1IWVVpK251QWRYSVRjMW5hVWliUWg3SVc4aVFMd0hhelZ0eFkK",
      "endpoints": ["https://github.com/MartiAble/YousoroWorkspace-app/releases/latest/download/latest.json"]
    }
  }
}
