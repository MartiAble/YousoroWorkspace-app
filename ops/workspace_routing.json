  "desktop_split_tun": {
    "log": {
      "level": "warn"
    },
    "dns": {
      "servers": [
        {
          "type": "local",
          "tag": "local"
        },
        {
          "type": "fakeip",
          "tag": "workspace-fake",
          "inet4_range": "198.18.0.0/15"
        }
      ],
      "rules": [
        {
          "domain": [],
          "domain_suffix": [],
          "query_type": [
            "A"
          ],
          "action": "route",
          "server": "workspace-fake"
        },
        {
          "domain": [],
          "domain_suffix": [],
          "action": "reject",
          "no_drop": true
        }
      ],
      "final": "local"
    },
    "inbounds": [
      {
        "type": "tun",
        "tag": "desktop-tun",
        "auto_route": true,
        "strict_route": false,
        "stack": "mixed",
        "address": [
          "172.19.0.1/30",
          "fdfe:dcba:9876::1/126"
        ]
      },
      {
        "type": "mixed",
        "tag": "workspace-loopback",
        "listen": "127.0.0.1",
        "listen_port": 0
      }
    ],
    "outbounds": [
      {
        "type": "direct",
        "tag": "direct"
      }
    ],
    "route": {
      "auto_detect_interface": true,
      "default_domain_resolver": "local",
      "final": "direct",
      "rules": [
        {"inbound": "desktop-tun", "action": "sniff"},
        {"inbound": "desktop-tun", "port": 53, "action": "hijack-dns"},
        {"inbound": "workspace-loopback", "network": "udp", "action": "reject"},
        {"inbound": "workspace-loopback", "ip_version": 6, "action": "reject"},
        {"inbound": "workspace-loopback", "action": "reject", "outbound": "proxy"},
        {"inbound": "desktop-tun", "domain": [], "domain_suffix": [], "network": "udp", "port": 443, "action": "reject"},
        {"inbound": "desktop-tun", "domain": [], "domain_suffix": [], "network": "udp", "action": "reject"},
        {"inbound": "desktop-tun", "domain": [], "domain_suffix": [], "ip_version": 6, "action": "reject"},
        {"inbound": "desktop-tun", "domain": [], "domain_suffix": [], "action": "reject", "outbound": "proxy"},
        {
          "ip_cidr": [
            "198.18.0.0/15"
          ],
          "action": "reject"
        }
      ]
    }
  }
